# Copy to .env and adjust if your local Supabase ports differ (see supabase/config.toml).
# Local Supabase default (from `npx supabase start`):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Port the API listens on. Pinned to 3001 because the frontend owns 3000 and
# proxies /api/* here — "whichever app booted first" is not an address.
# Unset in production: Cloud Run injects PORT=8080.
PORT=3001

# Origin allowed to call the API via CORS (the browser frontend).
# Unset means CORS is off entirely, which is correct in production: the browser
# only ever talks to the frontend's origin, which proxies through to us.
FRONTEND_URL="http://localhost:3000"

# Application session limits in milliseconds. Activity renews idle timeout, never beyond absolute cap.
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_LIFETIME_MS=43200000

# Development stand-in for Google sign-in (creator routes such as GET /me/contents).
# Only "true" switches it on, and it is always off when NODE_ENV=production. The caller
# is the creator id in the X-Dev-Creator-Id header, or DEV_CREATOR_ID when no header is
# sent (e.g. from the browser). Look up an id with: select id, first_name from creators;
# DEV_AUTH_ENABLED="true"
# DEV_CREATOR_ID=""

# "Sign in with Google": the Web application OAuth client in Google Auth Platform → Clients
# (project tofly-ugc-management). The redirect URI must match one registered on the client
# exactly. Optional locally (the login page then answers "Gagal masuk"); required when
# NODE_ENV=production, where the backend refuses to boot without all three.
# GOOGLE_CLIENT_ID="….apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"
