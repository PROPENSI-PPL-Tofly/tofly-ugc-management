# Copy to .env. The local Postgres from compose.yaml (`npm run db:up`), on 127.0.0.1:54322.
# Deployed environments get both URLs from Secret Manager instead.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Port the API listens on. Pinned to 3001 because the frontend owns 3000 and
# proxies /api/* here — "whichever app booted first" is not an address.
# Unset in production: Cloud Run injects PORT=8080.
PORT=3001

# Origin allowed to call the API via CORS (the browser frontend).
# Unset means CORS is off entirely, which is correct in production: the browser
# only ever talks to the frontend's origin, which proxies through to us.
FRONTEND_URL="http://localhost:3000"

# Application session limits in milliseconds. Activity renews idle timeout, never beyond absolute cap.
SESSION_IDLE_TIMEOUT_MS=1800000
SESSION_ABSOLUTE_LIFETIME_MS=43200000

# Development stand-in for Google sign-in. Only "true" switches it on, and it is always off
# when NODE_ENV=production; a request that carries a session cookie always uses the session.
# Creator routes (e.g. GET /me/contents): the caller is the creator id in the X-Dev-Creator-Id
# header, or DEV_CREATOR_ID when no header is sent (e.g. from the browser). Look up an id
# with: select id, first_name from creators;
# Admin routes (Creator Database, scheduling, draft review) let a request without a session in.
# DEV_AUTH_ENABLED="true"
# DEV_CREATOR_ID=""

# "Sign in with Google": the Web application OAuth client in Google Auth Platform → Clients
# (project tofly-ugc-management). The redirect URI must match one registered on the client
# exactly. Optional locally (the login page then answers "Gagal masuk"); required when
# NODE_ENV=production, where the backend refuses to boot without all three.
# GOOGLE_CLIENT_ID="….apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Connecting a creator's Instagram/TikTok account (PBI-19). All optional: whatever is unset
# switches that part off, and the Performa page answers "TikTok sedang bermasalah".
# SOCIAL_STATE_SECRET signs the OAuth state (at least 32 bytes): openssl rand -base64 48
# SOCIAL_TOKEN_KEY encrypts platform tokens at rest (exactly 32 bytes): openssl rand -base64 32
# Without SOCIAL_TOKEN_KEY no platform is offered, so no token is ever stored in the clear.
# Never commit real values; deployed environments read them from Secret Manager.
# SOCIAL_STATE_SECRET=""
# SOCIAL_TOKEN_KEY=""

# TikTok Login Kit (sandbox app, Login Kit with user.info.basic, user.info.profile, video.list).
# TikTok redirects only to an https URI registered on the app, so local development needs an
# https tunnel to the frontend, or testing on staging.
# TIKTOK_CLIENT_KEY=""
# TIKTOK_CLIENT_SECRET=""
# TIKTOK_REDIRECT_URI="https://<host>/api/social/tiktok/callback"
