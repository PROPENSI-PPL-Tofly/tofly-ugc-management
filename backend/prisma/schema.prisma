generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contents {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contract_id        String           @db.Uuid
  name               String
  type               content_type
  brief              String           @default("")
  deadline           DateTime         @db.Date
  status             content_status   @default(scheduled)
  is_proposal        Boolean          @default(false)
  proposal_notes     String?
  video_link         String?
  video_submitted_at DateTime?        @db.Date
  platform           social_platform?
  views              Int?
  likes              Int?
  engagement         Decimal?         @db.Decimal(5, 2)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  updated_at         DateTime         @default(now()) @db.Timestamptz(6)
  contracts          contracts        @relation(fields: [contract_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  submissions        submissions[]
  content_events     content_events[]

  @@index([contract_id, deadline], map: "contents_contract_deadline_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model contracts {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id    String        @db.Uuid
  start_date    DateTime      @db.Date
  end_date      DateTime      @db.Date
  days_between  Int
  content_quota Int
  fixed_rate    Decimal       @db.Decimal(14, 2)
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  updated_at    DateTime      @default(now()) @db.Timestamptz(6)
  contract_type contract_type
  contents      contents[]
  creators      creators      @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([creator_id, end_date(sort: Desc)], map: "contracts_creator_end_date_idx")
}

model creators {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String            @unique @db.Uuid
  first_name         String
  middle_name        String?
  last_name          String?
  phone_number       String?
  access_revoke_date DateTime?         @db.Date
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)
  contracts          contracts[]
  users              users             @relation(fields: [user_id], references: [id], onUpdate: NoAction)
  social_accounts    social_accounts[]
  submissions        submissions[]
  app_sessions       app_sessions[]
}

model social_accounts {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  creator_id       String          @db.Uuid
  platform         social_platform
  username         String
  access_token     String?
  refresh_token    String?
  token_expires_at DateTime?       @db.Timestamptz(6)
  is_connected     Boolean         @default(false)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime        @default(now()) @db.Timestamptz(6)
  creators         creators        @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([creator_id, platform])
}

model submissions {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_id     String   @db.Uuid
  creator_id     String   @db.Uuid
  link           String
  revision_notes String?
  creator_notes  String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  contents       contents @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creators       creators @relation(fields: [creator_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([content_id, created_at], map: "submissions_content_created_at_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model content_events {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_id  String   @db.Uuid
  event_type  String
  actor_name  String
  actor_role  String
  occurred_at DateTime @default(now()) @db.Timestamptz(6)
  event_data  Json     @db.JsonB
  contents    contents @relation(fields: [content_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([content_id, occurred_at(sort: Desc), id(sort: Desc)], map: "content_events_content_occurred_id_idx")
}

model users {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String         @unique @db.Citext
  is_admin     Boolean        @default(false)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  creators     creators?
  app_sessions app_sessions[]
}

model app_sessions {
  idHash              String   @id @map("id_hash") @db.Char(64)
  userId              String   @map("user_id") @db.Uuid
  role                String
  creatorId           String?  @map("creator_id") @db.Uuid
  idleExpiresAt       DateTime @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt   DateTime @map("absolute_expires_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  users               users     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creators            creators? @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([idleExpiresAt], map: "app_sessions_idle_expires_at_idx")
  @@index([absoluteExpiresAt], map: "app_sessions_absolute_expires_at_idx")
}

enum content_status {
  scheduled
  draft_review
  draft_revision
  draft_revised
  draft_approved
  link_submitted
}

enum content_type {
  evergreen
  specific
}

enum social_platform {
  instagram
  tiktok
}

enum contract_type {
  probation
  regular
}
